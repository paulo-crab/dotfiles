;; Practice mode: press physical Control+Alt+GUI+V to toggle.
;; Original modifiers, editing keys, Escape, arrows, digits, Home/End, Page Up/Down
;; are silent while active; use home-row modifiers and Caps navigation; held Space types numbers.
;; Tap Space for a space; hold 220 ms for numbers/symbols. Hold Caps for navigation.
;; Caps: A/S/D/F=CAGS, H/J/K/L=arrows, M=Backspace, ;=Delete, Space=Return.
;; Caps: V/,=Delete, B=Backspace, N=Return, W=next word, 0/4/$=line, U/O=page, G/T=document, [=Escape, X=Ctrl+D.
;; Kanata starter for macOS + US/UK QWERTY key positions.
;; CAGS: A/S/D/F -> Control/Option/Command/Shift when held.
;; Mirrored: J/K/L/; -> Shift/Command/Option/Control when held.
;; Tap the keys normally to type their usual characters.
;; The ; key is the physical key immediately to the right of L.
;; Use the U.S. macOS input source for the Swedish character shortcuts.
;; Hold either Option for Swedish positions: [=å, ;=ö, '=ä,
;; ]=¨/^, backslash='/asterisk, equals=´/grave; both Options+]=dead tilde.
;; Tap Caps Lock for Escape; hold for H/J/K/L arrows and Space=Return.
;; Tap Tab normally; hold bare Tab 250 ms for Homerow (Shift+Command+Space).
;; Right Command + H/J/K/L also navigates. Other Right Command shortcuts work.
;; Microsoft keyboard: physical Alt -> Command; physical Windows -> Option.
;; On that keyboard, Right Alt is Right Command and also activates navigation.
;; Reload saved configuration: Control + Shift + R (hold A for Control).
;; Plain Control + R stays available for fzf/history. Release keys after reload.
;; Exit any time: hold PHYSICAL Left Control + Space + Escape together.

(defcfg
  process-unmapped-keys yes
)

;; Each layer below follows this exact key order.
(defsrc
  caps a s d f g h j k l ; [ ' r
  lalt lmet ralt rmet
 spc n tab
  , b w 0 4 u t m x
  v lctl rctl lsft rsft bspc del ret esc left rght up down home end pgup pgdn
  1 2 3 5 6 7 8 9
  ] bksl =
  f1 f2 f3 f4 f5 f6 f7 f8 f9 f10 f11 f12
  o)

(defvar
  tap-time 200
  hold-time 200
  typing-idle 0

  ;; While deciding tap vs hold, another key from the same hand means "type".
  ;; For a shortcut, use the modifier on the opposite hand from the next key.
  left-hand-keys  (grv 1 2 3 4 5 q w e r t a s d f g z x c v b nubs)
  right-hand-keys (6 7 8 9 0 - = y u i o p [ ] h j k l ; ' n m , . /)
)

;; Match your connected Microsoft keyboard (USB receiver 045e:07a5).
;; Device 1 gets the Windows-keyboard modifier swap.
(definputdevices
  1 ((vendor_id 1118) (product_id 1957))
)

(defalias
  ;; These wait for the hold timeout, rather than turning typing rolls into
  ;; shortcuts. Prior-idle is disabled so a deliberate hold still works
  ;; immediately after another keystroke.
  a (tap-hold-tap-keys $tap-time $hold-time a lctl $left-hand-keys
       (require-prior-idle $typing-idle))
  s (tap-hold-tap-keys $tap-time $hold-time s lalt $left-hand-keys
       (require-prior-idle $typing-idle))
  d (tap-hold-tap-keys $tap-time $hold-time d lmet $left-hand-keys
       (require-prior-idle $typing-idle))
  f (tap-hold-tap-keys $tap-time $hold-time f lsft $left-hand-keys
       (require-prior-idle $typing-idle))
  j (tap-hold-tap-keys $tap-time $hold-time j rsft $right-hand-keys
       (require-prior-idle $typing-idle))
  k (tap-hold-tap-keys $tap-time $hold-time k rmet $right-hand-keys
       (require-prior-idle $typing-idle))
  l (tap-hold-tap-keys $tap-time $hold-time l ralt $right-hand-keys
       (require-prior-idle $typing-idle))
  semi (tap-hold-tap-keys $tap-time $hold-time ; rctl $right-hand-keys
       (require-prior-idle $typing-idle))

  ;; Swedish letters on the U.S. macOS input source.
  ;; Hold either Option at Swedish key positions: [=å, ;=ö, '=ä.
  ;; Either Shift gives Å/Ä/Ö. Control remains a normal modifier.
  ;; Use native U.S. Option/dead-key sequences. unmod keeps Control and
  ;; other held modifiers out of the character sequence.
  se-aa (fork (macro (unmod lalt a))
             (macro (unmod lalt lsft a)) (lsft rsft))
  se-ae (fork (macro (unmod lalt u) (unmod a))
             (macro (unmod lalt u) (unmod lsft a)) (lsft rsft))
  se-oe (fork (macro (unmod lalt u) (unmod o))
             (macro (unmod lalt u) (unmod lsft o)) (lsft rsft))
  ;; Either Option (optionally with Shift) invokes Swedish letters.
  ;; Command and Control combinations retain their US key events.
  se-ring (switch ((or lctl rctl lmet rmet)) [ break
                   ((or lalt ralt)) @se-aa break
                   () [ break)
  se-dia-o (switch ((or lctl rctl lmet rmet)) ; break
                   ((or lalt ralt)) @se-oe break
                   () ; break)
  se-dia-a (switch ((or lctl rctl lmet rmet)) ' break
                   ((or lalt ralt)) @se-ae break
                   () ' break)

  ;; Missing Swedish symbol positions on an ANSI U.S. keyboard. Option
  ;; selects the Swedish key; Shift selects its upper legend. Accent keys
  ;; retain macOS dead-key composition with the following letter.
  se-diaeresis (fork (unmod lalt u) (unmod lalt i) (lsft rsft))
  se-tilde (unmod lalt n)
  se-quote-star (fork (unmod ') (unmod lsft 8) (lsft rsft))
  se-acute-grave (fork (unmod lalt e) (unmod lalt grv) (lsft rsft))
  se-bracket-right (switch ((or lctl rctl lmet rmet)) ] break
                           ((and lalt ralt)) @se-tilde break
                           ((or lalt ralt)) @se-diaeresis break
                           () ] break)
  se-backslash (switch ((or lctl rctl lmet rmet)) bksl break
                       ((or lalt ralt)) @se-quote-star break
                       () bksl break)
  se-equals (switch ((or lctl rctl lmet rmet)) = break
                    ((or lalt ralt)) @se-acute-grave break
                    () = break)

  ;; Three physical modifiers + V toggle practice mode, even when their
  ;; output is suppressed. On the Microsoft keyboard, Alt and Windows still
  ;; count by their physical positions, regardless of the normal swap.
  practice-on (switch
    ((and (or (input real lctl) (input real rctl))
          (or (input real lalt) (input real ralt))
          (or (input real lmet) (input real rmet))))
      (layer-switch practice) break
    () v break)
  practice-off (switch
    ((and (or (input real lctl) (input real rctl))
          (or (input real lalt) (input real ralt))
          (or (input real lmet) (input real rmet))))
      (layer-switch base) break
    () v break)

  ;; Reserve only Control+Shift+R; Option/Command combinations pass through.
  reload-r (switch
    ((and (or lctl rctl) (or lsft rsft)
          (not lalt ralt lmet rmet))) lrld break
    () r break)

  ;; Preserve the semicolon Control hold with either Option. Choose case on
  ;; key press so releasing Shift quickly does not change the resulting ö.
  semi-oe (tap-hold-tap-keys $tap-time $hold-time
             (macro (unmod lalt u) (unmod o)) rctl $right-hand-keys
             (require-prior-idle $typing-idle))
  semi-oe-cap (tap-hold-tap-keys $tap-time $hold-time
                 (macro (unmod lalt u) (unmod lsft o)) rctl $right-hand-keys
                 (require-prior-idle $typing-idle))
  semi-option (switch ((or lctl rctl lmet rmet)) @semi break
                       ((and (or lalt ralt) (or lsft rsft))) @semi-oe-cap break
                       ((or lalt ralt)) @semi-oe break
                       () @semi break)

  ;; These additions require Caps navigation, preserving Right Command shortcuts.
  ;; Motions retain Shift for selection; 4/$ consumes Shift for plain line end.
  ;; Direct Caps modifiers avoid a second tap-hold decision inside navigation.
  nav-a (switch ((input real caps)) lctl break () a break)
  nav-s (switch ((input real caps)) lalt break () s break)
  nav-d (switch ((input real caps)) lmet break () d break)
  nav-f (switch ((input real caps)) lsft break () f break)
  nav-delete (switch ((input real caps)) (unmod del) break () , break)
  nav-delete-v (switch ((input real caps)) (unmod del) break () @practice-on break)
  nav-delete-semi (switch ((input real caps)) del break () @se-dia-o break)
  nav-backspace-b (switch ((input real caps)) (unmod bspc) break () b break)
  nav-word-right (switch ((input real caps)) (unmod (lctl rctl lalt ralt lmet rmet) lalt rght) break () w break)
  nav-line-start (switch ((input real caps)) (unmod (lctl rctl lalt ralt lmet rmet) lmet left) break () 0 break)
  nav-line-end (switch ((input real caps)) (unmod lmet rght) break () 4 break)
  nav-page-up (switch ((input real caps)) (unmod (lctl rctl lalt ralt lmet rmet) pgup) break () u break)
  nav-page-down-o (switch ((input real caps)) (unmod (lctl rctl lalt ralt lmet rmet) pgdn) break () o break)
  nav-doc-end (switch ((input real caps)) (unmod (lctl rctl lalt ralt lmet rmet) lmet down) break () g break)
  nav-doc-start (switch ((input real caps)) (unmod (lctl rctl lalt ralt lmet rmet) lmet up) break () t break)
  nav-escape (switch ((input real caps)) (unmod esc) break () @se-ring break)
  nav-backspace (switch ((input real caps)) bspc break () m break)
  nav-control-d (switch ((input real caps)) (unmod lctl d) break () x break)

  ;; Caps+Space is Return and accepts modifiers; Right Command+Space stays Command+Space.
  nav-space (switch ((input real caps)) ret break
                    () spc break)
  ;; Caps+N sends Return; Right Command+N keeps its shortcut.
  nav-enter (switch ((input real caps)) (unmod ret) break
                    () n break)
  ;; Bare Tab: tap for Tab; hold 250 ms to activate the Homerow app once.
  ;; With any modifier already held, retain the ordinary Tab shortcut.
  homerow (macro (unmod lsft lmet spc))
  homerow-tab (switch
    ((or lctl rctl lalt ralt lmet rmet lsft rsft)) tab break
    () (tap-hold 200 250 tab @homerow) break)

  nav (layer-while-held nav)
  ;; Space: tap normally; hold 220 ms for the number/symbol layer.
  ;; Caps and Right Command still provide navigation.
  space-numsym (layer-while-held numbers-symbols)
  ;; Preserve modifier+Space shortcuts when the modifier was held first.
  space (switch
    ((or lctl rctl lalt ralt lmet rmet lsft rsft)) spc break
    () (tap-hold 200 220 spc @space-numsym) break)

  ;; Caps activates navigation immediately when the next key is pressed.
  ;; Navigation works straight after typing too.
  caps (tap-hold-press 200 200 esc @nav)

  ;; Keep Right Command available for its other shortcuts, while adding nav.
  rnav (multi rmet @nav)

  ;; HID Alt is Option; HID Meta is Command on macOS. Outputs are not
  ;; remapped a second time, so home-row Command holds still send Command.
  left-alt  (switch ((device-history 1 1)) lmet break () lalt break)
  left-win  (switch ((device-history 1 1)) lalt break () lmet break)
  right-alt (switch ((device-history 1 1)) @rnav break () ralt break)
  right-win (switch ((device-history 1 1)) ralt break () @rnav break)

  ;; Restore the MacBook's printed top-row actions. Keep the Microsoft
  ;; keyboard's F keys, and pass through Fn+F keys when Fn is visible.
  mac-f1  (switch ((or (device-history 1 1) (input real fn))) f1  break () brdn break)
  mac-f2  (switch ((or (device-history 1 1) (input real fn))) f2  break () brup break)
  mac-f3  (switch ((or (device-history 1 1) (input real fn))) f3  break () mctl break)
  mac-f4  (switch ((or (device-history 1 1) (input real fn))) f4  break () sls  break)
  mac-f5  (switch ((or (device-history 1 1) (input real fn))) f5  break () dtn  break)
  mac-f6  (switch ((or (device-history 1 1) (input real fn))) f6  break () dnd  break)
  mac-f7  (switch ((or (device-history 1 1) (input real fn))) f7  break () prev break)
  mac-f8  (switch ((or (device-history 1 1) (input real fn))) f8  break () pp   break)
  mac-f9  (switch ((or (device-history 1 1) (input real fn))) f9  break () next break)
  mac-f10 (switch ((or (device-history 1 1) (input real fn))) f10 break () mute break)
  mac-f11 (switch ((or (device-history 1 1) (input real fn))) f11 break () vold break)
  mac-f12 (switch ((or (device-history 1 1) (input real fn))) f12 break () volu break)

  ;; Remove Right Command from arrows; retain Shift/Option/Control selection.
  left  (unmod (rmet) left)
  down  (unmod (rmet) down)
  up    (unmod (rmet) up)
  right (unmod (rmet) rght)
)

(deflayer base
  @caps @a @s @d @f g h @j @k @l @semi-option @se-ring @se-dia-a @reload-r
  @left-alt @left-win @right-alt @right-win @space n @homerow-tab
  , b w 0 4 u t m x
  @practice-on lctl rctl lsft rsft bspc del ret esc left rght up down home end pgup pgdn
  1 2 3 5 6 7 8 9
  @se-bracket-right @se-backslash @se-equals
  @mac-f1 @mac-f2 @mac-f3 @mac-f4 @mac-f5 @mac-f6 @mac-f7 @mac-f8 @mac-f9 @mac-f10 @mac-f11 @mac-f12
  o
)

;; Caps keeps left CAGS as direct modifiers and Vim-style H/J/K/L arrows.
;; Right Command navigation retains ordinary A/S/D/F/O/; shortcuts.
;; Physical Shift + navigation selects text. `_` inherits the base action.
(deflayer nav
  _ @nav-a @nav-s @nav-d @nav-f @nav-doc-end @left @down @up @right @nav-delete-semi @nav-escape _ @reload-r
  _ _ _ _ @nav-space @nav-enter _
  @nav-delete @nav-backspace-b @nav-word-right @nav-line-start @nav-line-end @nav-page-up @nav-doc-start @nav-backspace @nav-control-d
  @nav-delete-v _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _
  _ _ _ _ _ _ _ _
  _ _ _
  _ _ _ _ _ _ _ _ _ _ _ _
  @nav-page-down-o
)

;; Practice mode preserves home-row modifiers, Caps navigation, and Space numbers.
;; Original physical modifiers, editing/movement keys, and digits 1-0 are silent.
;; Physical Control+Alt+GUI+V still switches back to base.
(deflayer practice
  @caps @a @s @d @f g h @j @k @l @semi-option @se-ring @se-dia-a @reload-r
  XX XX XX XX @space n @homerow-tab
  , b w XX XX u t m x
  @practice-off XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX XX
  XX XX XX XX XX XX XX XX
  @se-bracket-right @se-backslash @se-equals
  @mac-f1 @mac-f2 @mac-f3 @mac-f4 @mac-f5 @mac-f6 @mac-f7 @mac-f8 @mac-f9 @mac-f10 @mac-f11 @mac-f12
  o
)

;; Miryoku-inspired left-hand number/symbol layer, held by the right thumb on Space.
;; QWERT/ASDFG/ZXCVB form the five-column grid on a staggered keyboard.
;; The right home row keeps SGAC; hold Space first, then J for shifted symbols.
;; B supplies 0 since Space is the layer key; Tab is decimal, both the ANSI
;; grave and ISO section (nubs) positions are minus, and 1 is backslash/pipe.
;; Editing stays on Caps; the physical three-modifier+V practice toggle remains.
(deflayermap (numbers-symbols)
  caps @caps
  spc @space
  lalt @left-alt
  lmet @left-win
  ralt @right-alt
  rmet @right-win
  j @j  k @k  l @l  ; @semi-option

  q [    w 7    e 8    r 9    t ]
  a ;    s 4    d 5    f 6    g =
  z grv  x 1    c 2    v 3    b 0

  tab .  grv -  nubs -  1 bksl
)
